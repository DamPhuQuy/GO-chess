# --- Backend Service ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data/goban.sqlite

# KataGo AI Engine URL (use http://katago:2718 in Docker, http://localhost:2718 locally)
KATAGO_API_URL=http://localhost:2718

# --- Frontend Service ---
# Port exposed on host when running via docker-compose
FRONTEND_PORT=8088

# Backend URL used by Vite dev server proxy (local dev)
BACKEND_ORIGIN=http://127.0.0.1:8080
